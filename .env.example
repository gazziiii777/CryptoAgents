# Скопировать в .env и заполнить. Обязательные ключи проверяются на старте `run` (preflight).

# --- БД (MariaDB) / Docker. Дефолты совпадают с сервисом db в docker-compose. ---
COMPOSE_PROFILES=init            # чтобы `docker compose up` поднимал сервис migrate
DB_HOST=db                       # с ХОСТА (Sequel Ace / локальный uv run): 127.0.0.1
DB_PORT=3306
DB_USER=tradingagents
DB_PASSWORD=tradingagents
DB_NAME=tradingagents
DB_RESEARCH_NAME=research
DB_ROOT_PASSWORD=tradingagents_root
# Бэкап БД (сервис `backup`, mariadb-dump → ./backups):
DB_BACKUP_INTERVAL_S=86400        # как часто делать дамп (по умолчанию раз в сутки)
DB_BACKUP_RETENTION_DAYS=7        # сколько дней хранить дампы

# --- Обязательные ---
LUNARCRUSH_API_KEY=
COINGLASS_API_KEY=
OPENAI_API_KEY=

# --- LLM-провайдер (openai | anthropic). По умолчанию openai. ---
LLM_PROVIDER=openai
# Нужен только если LLM_PROVIDER=anthropic:
ANTHROPIC_API_KEY=

# --- Опциональные ---
COINGECKO_API_KEY=
LLM_DAILY_BUDGET_USD=5.0

# --- Telegram-уведомления (опционально: при обоих заданных шлёт открытие/закрытие позиций) ---
# Токен от @BotFather; chat_id — свой ID (узнать у @userinfobot) или ID группы.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Paper-аккаунт (дефолты можно не задавать) ---
DEFAULT_ACCOUNT_NAME=paper
DEFAULT_INITIAL_BALANCE=2000

# --- Риск/сайзинг (риск растёт с уверенностью: min при confluence=гейт, max при 1.0) ---
RISK_PER_TRADE_MIN_PCT=0.005     # риск на сделку у порога уверенности (0.5% NAV)
RISK_PER_TRADE_MAX_PCT=0.02      # риск при максимальной уверенности (2% NAV; поднять для агрессии)
CONFLUENCE_GATE=0.50             # ниже — сделки нет (порог уверенности)
RISK_REWARD_MIN=1.5              # минимальный R:R, иначе отклоняем
# Портфельные лимиты (бэкстоп):
MAX_CONCURRENT_POSITIONS=5
MAX_SAME_DIRECTION=2
DRAWDOWN_HALT_PCT=0.10           # −10% NAV → стоп новых входов
FUNDING_KILL_SWITCH_PCT=0.0025
